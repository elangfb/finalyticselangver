    "immer": "^10.1.3",
    "js-sha256": "^0.11.1",
    "jspdf": "^3.0.3",
    "marked": "^16.4.0",
    "slim-select": "^3.0.3",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@parcel/config-default": "^2.16.0",
    "@parcel/packager-raw-url": "^2.16.0",
    "@parcel/transformer-webmanifest": "^2.16.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@tsconfig/recommended": "^1.0.10",
    "@types/node": "^22.18.10",
    "buffer": "^6.0.3",
    "dprint": "^0.50.2",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "ignore": "^7.0.5",
    "parcel": "^2.16.0",
    "parcel-namer-hashless": "^1.0.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "browserslist": [
    "defaults"
  ],
