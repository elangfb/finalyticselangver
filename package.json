{
  "name": "@arunami/finalytics",
  "type": "module",
  "source": "index.html",
  "engines": {
    "node": ">= 22.17 < 23"
  },
  "scripts": {
    "dev": "pnpm install && pnpm run clean && parcel",
    "build": "parcel build",
    "clean": "rimraf .parcel-cache dist",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit",
    "check": "dprint check && pnpm run typecheck && pnpm run lint",
    "format": "dprint fmt && pnpm run lint:fix",
    "llms": "tsx scripts/generate-context.ts",
    "llms:full": "pnpm run llms-full",
    "llms-full": "tsx scripts/generate-full-context.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "deepmerge-ts": "^7.1.5",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^11.10.0",
